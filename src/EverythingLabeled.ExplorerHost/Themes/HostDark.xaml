<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme tokens. Swap this dictionary later for light / other themes. -->
    <Color x:Key="HostBgColor">#1B1F2A</Color>
    <Color x:Key="HostFgColor">#F2F4F8</Color>
    <Color x:Key="HostMutedColor">#9AA3B2</Color>
    <Color x:Key="HostInputBgColor">#12151C</Color>
    <Color x:Key="HostRowHoverColor">#252A38</Color>
    <Color x:Key="HostRowSelectedColor">#2C3345</Color>
    <Color x:Key="HostAccentColor">#4EA1FF</Color>
    <Color x:Key="HostTealColor">#2EC4B6</Color>
    <Color x:Key="HostTealDarkColor">#249E93</Color>
    <Color x:Key="HostChipColor">#1FA396</Color>
    <Color x:Key="HostBorderColor">#2E3545</Color>
    <Color x:Key="HostDangerColor">#E81123</Color>
    <Color x:Key="HostOnAccentColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="HostBgBrush" Color="{StaticResource HostBgColor}" />
    <SolidColorBrush x:Key="HostFgBrush" Color="{StaticResource HostFgColor}" />
    <SolidColorBrush x:Key="HostMutedBrush" Color="{StaticResource HostMutedColor}" />
    <SolidColorBrush x:Key="HostInputBgBrush" Color="{StaticResource HostInputBgColor}" />
    <SolidColorBrush x:Key="HostRowHoverBrush" Color="{StaticResource HostRowHoverColor}" />
    <SolidColorBrush x:Key="HostRowSelectedBrush" Color="{StaticResource HostRowSelectedColor}" />
    <SolidColorBrush x:Key="HostAccentBrush" Color="{StaticResource HostAccentColor}" />
    <SolidColorBrush x:Key="HostTealBrush" Color="{StaticResource HostTealColor}" />
    <SolidColorBrush x:Key="HostTealDarkBrush" Color="{StaticResource HostTealDarkColor}" />
    <SolidColorBrush x:Key="HostChipBrush" Color="{StaticResource HostChipColor}" />
    <SolidColorBrush x:Key="HostBorderBrush" Color="{StaticResource HostBorderColor}" />
    <SolidColorBrush x:Key="HostDangerBrush" Color="{StaticResource HostDangerColor}" />
    <SolidColorBrush x:Key="HostOnAccentBrush" Color="{StaticResource HostOnAccentColor}" />
</ResourceDictionary>
