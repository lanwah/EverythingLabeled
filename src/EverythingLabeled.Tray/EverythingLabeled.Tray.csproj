<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EverythingLabeled.Tray</RootNamespace>
    <AssemblyName>EverythingLabeled.Tray</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverythingLabeled.ExplorerShared\EverythingLabeled.ExplorerShared.csproj" />
    <ProjectReference Include="..\EverythingLabeled.ExplorerHost\EverythingLabeled.ExplorerHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\tray.ico" CopyToOutputDirectory="PreserveNewest" Link="Assets\tray.ico" />
  </ItemGroup>

  <Target Name="CopyExplorerHostOutput" AfterTargets="Build">
    <PropertyGroup>
      <_HostOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\EverythingLabeled.ExplorerHost\bin\$(Configuration)\net8.0-windows\'))</_HostOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_HostFiles Include="$(_HostOutDir)**\*" />
    </ItemGroup>
    <Error Condition="'@(_HostFiles)' == ''" Text="ExplorerHost output not found under $(_HostOutDir). Build Host first." />
    <Copy SourceFiles="@(_HostFiles)" DestinationFolder="$(TargetDir)%(_HostFiles.RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
