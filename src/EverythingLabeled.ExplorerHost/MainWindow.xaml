<Window x:Class="EverythingLabeled.ExplorerHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverythingLabeled.ExplorerHost"
        Title="EverythingLabeled"
        Height="520"
        Width="640"
        MinHeight="360"
        MinWidth="480">
    <DockPanel Margin="10">
        <TextBlock x:Name="BannerText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Margin="0,0,0,8"
                   Visibility="Collapsed" />

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <!-- tag -->
        <Grid x:Name="TagPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="TagPathList" Grid.Row="0" />
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="{x:Static local:Copy.AliasLabel}" />
                <TextBox x:Name="TagAliasBox"
                         Grid.Column="1"
                         Height="24"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSuggestAliasChanged" />
            </Grid>
            <ListBox x:Name="TagSuggestList"
                     Grid.Row="2"
                     MaxHeight="120"
                     Margin="0,4,0,0"
                     MouseDoubleClick="OnSuggestItemActivate"
                     KeyDown="OnSuggestListKeyDown" />
            <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                <CheckBox x:Name="CreateMissingCheck"
                          Content="{x:Static local:Copy.CreateMissingLabel}"
                          VerticalAlignment="Center" />
                <Button x:Name="TagSubmitButton"
                        DockPanel.Dock="Right"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Content="{x:Static local:Copy.SubmitTag}"
                        Click="OnTagSubmit" />
                <Button x:Name="TagCancelButton"
                        DockPanel.Dock="Right"
                        MinWidth="72"
                        Content="{x:Static local:Copy.Cancel}"
                        IsEnabled="False"
                        Click="OnBatchCancel" />
            </DockPanel>
        </Grid>

        <!-- untag -->
        <Grid x:Name="UntagPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="UntagPathList" Grid.Row="0" />
            <DockPanel x:Name="UntagTagListPanel" Grid.Row="1" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,4"
                           Text="{x:Static local:Copy.UntagTagListHint}" />
                <ListBox x:Name="UntagTagList"
                         SelectionChanged="OnUntagTagSelected" />
            </DockPanel>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="{x:Static local:Copy.AliasLabel}" />
                <TextBox x:Name="UntagAliasBox"
                         Grid.Column="1"
                         Height="24"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSuggestAliasChanged" />
            </Grid>
            <ListBox x:Name="UntagSuggestList"
                     Grid.Row="3"
                     MaxHeight="100"
                     Margin="0,4,0,0"
                     MouseDoubleClick="OnSuggestItemActivate"
                     KeyDown="OnSuggestListKeyDown" />
            <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
                <Button x:Name="UntagSubmitButton"
                        DockPanel.Dock="Right"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Content="{x:Static local:Copy.SubmitUntag}"
                        Click="OnUntagSubmit" />
                <Button x:Name="UntagCancelButton"
                        DockPanel.Dock="Right"
                        MinWidth="72"
                        Content="{x:Static local:Copy.Cancel}"
                        IsEnabled="False"
                        Click="OnBatchCancel" />
            </DockPanel>
        </Grid>

        <!-- tags -->
        <Grid x:Name="TagsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="TagsPathList" Grid.Row="0" MaxHeight="80" />
            <ListBox x:Name="TagsTagList" Grid.Row="1" Margin="0,8,0,0" />
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button x:Name="SwitchToTagButton"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Content="{x:Static local:Copy.SwitchToTag}"
                        Click="OnSwitchToTag" />
                <Button x:Name="SwitchToUntagButton"
                        MinWidth="100"
                        Content="{x:Static local:Copy.SwitchToUntag}"
                        Click="OnSwitchToUntag" />
            </StackPanel>
        </Grid>

        <!-- find -->
        <Grid x:Name="FindPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="{x:Static local:Copy.QueryLabel}" />
                <TextBox x:Name="FindQueryBox"
                         Grid.Column="1"
                         Height="24"
                         VerticalContentAlignment="Center"
                         KeyDown="OnFindQueryKeyDown" />
                <Button x:Name="FindPreviewButton"
                        Grid.Column="2"
                        MinWidth="72"
                        Margin="8,0,0,0"
                        Content="{x:Static local:Copy.Preview}"
                        Click="OnFindPreview" />
            </Grid>
            <ListBox x:Name="FindResultList"
                     Grid.Row="1"
                     Margin="0,8,0,0"
                     MouseDoubleClick="OnFindOpen" />
            <Button x:Name="FindOpenButton"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    MinWidth="72"
                    Margin="0,8,0,0"
                    Content="{x:Static local:Copy.Open}"
                    Click="OnFindOpen" />
        </Grid>
    </DockPanel>
</Window>
