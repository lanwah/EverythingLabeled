<Window x:Class="EverythingLabeled.ExplorerHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverythingLabeled.ExplorerHost"
        Title="EverythingLabeled"
        Height="520"
        Width="640"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FindQueryBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource HostFgBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="FindSuggestItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="0">
                            <Grid>
                                <Border x:Name="Accent"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource HostAccentBrush}"
                                        CornerRadius="2"
                                        Margin="0,8"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="12,10,12,10" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowSelectedBrush}" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HostMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource FindChromeButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HostDangerBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource HostOnAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FindFieldClearTagsStyle" TargetType="Button" BasedOn="{StaticResource FindChromeButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="FindClearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindOpenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource HostTealBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HostOnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostTealDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindChipRemoveStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HostOnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HostSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HostMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HostInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource HostInputBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource HostFgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HostAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HostSurfaceListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource HostInputBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Padding="0" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HostPathItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource HostBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HostRowSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FindResultTagTemplate">
            <Border x:Name="TagBd"
                    CornerRadius="3"
                    Padding="6,1"
                    Margin="0,0,4,0"
                    BorderThickness="1"
                    BorderBrush="{StaticResource HostResultTagBorderBrush}"
                    Background="{StaticResource HostResultTagFillBrush}"
                    MaxWidth="120">
                <TextBlock Text="{Binding}"
                           Foreground="{StaticResource HostTealBrush}"
                           FontSize="11"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter TargetName="TagBd" Property="Background" Value="{StaticResource HostResultTagFillSelectedBrush}" />
                    <Setter TargetName="TagBd" Property="BorderBrush" Value="{StaticResource HostResultTagBorderSelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RemovableAliasChipTemplate">
            <Border Background="{StaticResource HostChipBrush}"
                    CornerRadius="4"
                    Padding="8,4"
                    Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Display}"
                               Foreground="{StaticResource HostOnAccentBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource FindChipRemoveStyle}"
                            Content="×"
                            Tag="{Binding Alias}"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Click="OnCurrentTagChipRemove" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="HostChipItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{StaticResource HostChipBrush}"
                                CornerRadius="4"
                                Padding="8,3">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HostCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource HostFgBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="TagAliasBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FindQueryBoxStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HostSuggestPopupListStyle" TargetType="ListBox" BasedOn="{StaticResource FindListBoxStyle}">
            <Setter Property="Background" Value="{StaticResource HostInputBgBrush}" />
            <Setter Property="MaxHeight" Value="220" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Padding" Value="4,6" />
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootDock" Margin="10">
        <Border x:Name="FindCaptionBar"
                DockPanel.Dock="Top"
                Background="{StaticResource HostBgBrush}"
                Height="36"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnFindCaptionMouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="HostCaptionIcon"
                               Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource HostMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="FindCaptionTitle"
                               Text="{x:Static local:Copy.WindowTitleFind}"
                               Foreground="{StaticResource HostFgBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FindChromeButtonStyle}"
                            Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="OnFindMinimize" />
                    <Button Style="{StaticResource FindChromeButtonStyle}"
                            Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="OnFindMaximize" />
                    <Button Style="{StaticResource FindCloseButtonStyle}"
                            Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="OnFindClose" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="BannerText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Margin="0,0,0,8"
                   Visibility="Collapsed" />

        <DockPanel x:Name="FooterDock"
                   DockPanel.Dock="Bottom"
                   LastChildFill="True"
                   Margin="0,12,0,0">
            <Button x:Name="FindOpenButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource FindOpenButtonStyle}"
                    MinWidth="72"
                    Margin="8,0,0,0"
                    Visibility="Collapsed"
                    IsTabStop="False"
                    Content="{x:Static local:Copy.Open}"
                    Click="OnFindOpen" />
            <Button x:Name="FindClearButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource FindClearButtonStyle}"
                    MinWidth="88"
                    Visibility="Collapsed"
                    IsTabStop="False"
                    Content="{x:Static local:Copy.ClearTags}"
                    Click="OnFindClearTags" />
            <Button x:Name="SwitchToUntagButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource FindOpenButtonStyle}"
                    MinWidth="100"
                    Visibility="Collapsed"
                    Content="{x:Static local:Copy.SwitchToUntag}"
                    Click="OnSwitchToUntag" />
            <Button x:Name="SwitchToTagButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource FindClearButtonStyle}"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Content="{x:Static local:Copy.SwitchToTag}"
                    Click="OnSwitchToTag" />
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource HostMutedBrush}"
                       FontSize="13" />
        </DockPanel>

        <!-- Last DockPanel child fills; keep all modes in one host so none dock Left at half width. -->
        <Grid x:Name="ModeHost">
        <!-- tag -->
        <Grid x:Name="TagPanel" Visibility="Collapsed" Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Style="{StaticResource HostSectionLabelStyle}"
                       Text="{x:Static local:Copy.PathsSectionLabel}" />
            <ListBox x:Name="TagPathList"
                     Grid.Row="1"
                     MinHeight="72"
                     Style="{StaticResource HostSurfaceListStyle}"
                     ItemContainerStyle="{StaticResource HostPathItemStyle}" />
            <DockPanel x:Name="TagCurrentTagPanel"
                       Grid.Row="2"
                       MaxHeight="160"
                       Margin="0,10,0,0"
                       Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource HostSectionLabelStyle}"
                           Text="{x:Static local:Copy.UntagTagListHint}" />
                <Border Background="{StaticResource HostInputBgBrush}"
                        BorderBrush="{StaticResource HostBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <ItemsControl x:Name="TagCurrentTagList"
                                      ItemTemplate="{StaticResource RemovableAliasChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource HostMutedBrush}"
                           FontSize="13"
                           Text="{x:Static local:Copy.AliasLabel}" />
                <Grid Grid.Column="1" x:Name="TagAliasField">
                    <Border x:Name="TagAliasInputBorder"
                            Background="{StaticResource HostInputBgBrush}"
                            BorderBrush="{StaticResource HostBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="36"
                            Padding="8,0">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl x:Name="TagChipList" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource HostChipBrush}"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,2,6,2"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{StaticResource HostOnAccentBrush}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource FindChipRemoveStyle}"
                                                        Content="×"
                                                        Tag="{Binding}"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Click="OnTagChipRemove" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid MinWidth="72"
                                  MinHeight="24"
                                  Margin="0,2,0,2"
                                  VerticalAlignment="Center">
                                <TextBlock x:Name="TagAliasPlaceholder"
                                           Text="{x:Static local:Copy.AliasPlaceholder}"
                                           Foreground="{StaticResource HostMutedBrush}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="TagAliasBox"
                                         Style="{StaticResource TagAliasBoxStyle}"
                                         MinWidth="72"
                                         VerticalAlignment="Center"
                                         TextChanged="OnSuggestAliasChanged"
                                         PreviewKeyDown="OnTagAliasPreviewKeyDown" />
                            </Grid>
                        </WrapPanel>
                    </Border>
                    <Popup x:Name="TagSuggestPopup"
                           PlacementTarget="{Binding ElementName=TagAliasInputBorder}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{StaticResource HostInputBgBrush}"
                                BorderBrush="{StaticResource HostBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Width="{Binding ActualWidth, ElementName=TagAliasInputBorder}"
                                MinWidth="{Binding ActualWidth, ElementName=TagAliasInputBorder}"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24"
                                                  ShadowDepth="8"
                                                  Opacity="0.45"
                                                  Direction="270"
                                                  Color="Black" />
                            </Border.Effect>
                            <ListBox x:Name="TagSuggestList"
                                     Style="{StaticResource HostSuggestPopupListStyle}"
                                     ItemContainerStyle="{StaticResource FindSuggestItemStyle}"
                                     DisplayMemberPath="Display"
                                     MouseDoubleClick="OnSuggestItemActivate"
                                     KeyDown="OnSuggestListKeyDown" />
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
            <CheckBox x:Name="CreateMissingCheck"
                      Grid.Row="4"
                      Margin="0,10,0,0"
                      Style="{StaticResource HostCheckBoxStyle}"
                      Content="{x:Static local:Copy.CreateMissingLabel}" />
            <DockPanel Grid.Row="5"
                       Margin="0,10,0,0"
                       LastChildFill="False"
                       HorizontalAlignment="Right"
                       Visibility="Collapsed">
                <Button x:Name="TagCancelButton"
                        Style="{StaticResource FindClearButtonStyle}"
                        MinWidth="72"
                        Content="{x:Static local:Copy.Cancel}"
                        IsEnabled="False"
                        Click="OnBatchCancel" />
                <Button x:Name="TagSubmitButton"
                        Style="{StaticResource FindOpenButtonStyle}"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Content="{x:Static local:Copy.SubmitTag}"
                        Click="OnTagSubmit" />
            </DockPanel>
        </Grid>

        <!-- untag -->
        <Grid x:Name="UntagPanel" Visibility="Collapsed" Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Style="{StaticResource HostSectionLabelStyle}"
                       Text="{x:Static local:Copy.PathsSectionLabel}" />
            <ListBox x:Name="UntagPathList"
                     Grid.Row="1"
                     MinHeight="72"
                     MaxHeight="120"
                     Style="{StaticResource HostSurfaceListStyle}"
                     ItemContainerStyle="{StaticResource HostPathItemStyle}" />
            <DockPanel x:Name="UntagTagListPanel"
                       Grid.Row="2"
                       Margin="0,10,0,0"
                       VerticalAlignment="Stretch">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource HostSectionLabelStyle}"
                           Text="{x:Static local:Copy.CurrentTagsLabel}" />
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="UntagTagFilterBox"
                                 Style="{StaticResource HostInputStyle}"
                                 Height="32"
                                 FontSize="13"
                                 HorizontalContentAlignment="Left"
                                 TextChanged="OnUntagTagFilterChanged"
                                 GotFocus="OnUntagTagFilterFocusChanged"
                                 LostFocus="OnUntagTagFilterFocusChanged" />
                        <TextBlock x:Name="UntagTagFilterPlaceholder"
                                   Text="{x:Static local:Copy.UntagFilterPlaceholder}"
                                   IsHitTestVisible="False"
                                   Margin="10,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource HostMutedBrush}"
                                   FontSize="13" />
                    </Grid>
                    <TextBlock x:Name="UntagTagFilterCount"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               MinWidth="40"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource HostMutedBrush}"
                               FontSize="12"
                               Visibility="Collapsed" />
                </Grid>
                <Border Background="{StaticResource HostInputBgBrush}"
                        BorderBrush="{StaticResource HostBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        MinHeight="120">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl x:Name="UntagTagList"
                                          ItemTemplate="{StaticResource RemovableAliasChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="UntagTagsEmpty"
                                   Text="{x:Static local:Copy.UntagTagsEmpty}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource HostMutedBrush}"
                                   FontSize="13"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="UntagFilterMiss"
                                   Text="{x:Static local:Copy.UntagFilterMiss}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource HostMutedBrush}"
                                   FontSize="13"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>

        <!-- tags -->
        <Grid x:Name="TagsPanel" Visibility="Collapsed" Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Style="{StaticResource HostSectionLabelStyle}"
                       Text="{x:Static local:Copy.PathSectionLabel}" />
            <ListBox x:Name="TagsPathList"
                     Grid.Row="1"
                     MaxHeight="72"
                     Style="{StaticResource HostSurfaceListStyle}"
                     ItemContainerStyle="{StaticResource HostPathItemStyle}" />
            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       Style="{StaticResource HostSectionLabelStyle}"
                       Text="{x:Static local:Copy.TagsSectionLabel}" />
            <Border Grid.Row="3"
                    Background="{StaticResource HostInputBgBrush}"
                    BorderBrush="{StaticResource HostBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <ListBox x:Name="TagsTagList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource HostChipItemStyle}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Alias}"
                                       Foreground="{StaticResource HostOnAccentBrush}"
                                       FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- find -->
        <Grid x:Name="FindPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,12,16,0">
                <Border
                        Background="{StaticResource HostInputBgBrush}"
                        BorderBrush="{StaticResource HostBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        MinHeight="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{StaticResource HostMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Grid Grid.Column="1">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ItemsControl x:Name="FindChipList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource HostChipBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,6,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource HostOnAccentBrush}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource FindChipRemoveStyle}"
                                                            Content="×"
                                                            Tag="{Binding}"
                                                            Margin="6,0,0,0"
                                                            Click="OnFindChipRemove" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid MinWidth="120" Margin="0,0,0,4">
                                    <TextBlock x:Name="FindQueryPlaceholder"
                                               Text="{x:Static local:Copy.FindQueryPlaceholder}"
                                               Foreground="{StaticResource HostMutedBrush}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <TextBox x:Name="FindQueryBox"
                                             Style="{StaticResource FindQueryBoxStyle}"
                                             FontSize="14"
                                             MinWidth="120"
                                             TextChanged="OnFindQueryChanged"
                                             PreviewKeyDown="OnFindQueryKeyDown" />
                                </Grid>
                            </WrapPanel>
                        </Grid>
                        <Button Grid.Column="2"
                                x:Name="FindClearTagsButton"
                                Style="{StaticResource FindFieldClearTagsStyle}"
                                Visibility="Collapsed"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE894;"
                                ToolTip="{x:Static local:Copy.ClearTags}"
                                Click="OnFindClearTags" />
                    </Grid>
                </Border>
            </Grid>

            <ListBox x:Name="FindSuggestList"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Style="{StaticResource FindListBoxStyle}"
                     ItemContainerStyle="{StaticResource FindSuggestItemStyle}"
                     DisplayMemberPath="Display"
                     Margin="16,6,16,0"
                     MouseDoubleClick="OnSuggestItemActivate"
                     KeyDown="OnSuggestListKeyDown" />

            <ListBox x:Name="FindResultList"
                     Grid.Row="2"
                     VerticalAlignment="Stretch"
                     Style="{StaticResource FindListBoxStyle}"
                     ItemContainerStyle="{StaticResource FindResultItemStyle}"
                     Margin="8,4,8,8"
                     MouseDoubleClick="OnFindOpen"
                     KeyDown="OnFindResultKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0"
                                       Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"
                                       Margin="4,0,14,0"
                                       SnapsToDevicePixels="True">
                                <Rectangle.OpacityMask>
                                    <ImageBrush Stretch="Uniform"
                                                ImageSource="{Binding Kind, Converter={x:Static local:KindIconConverter.Instance}}" />
                                </Rectangle.OpacityMask>
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{StaticResource HostMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                         Value="True">
                                                <Setter Property="Fill" Value="{StaticResource HostAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HostFgBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" />
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding TagLabels}"
                                                  ItemTemplate="{StaticResource FindResultTagTemplate}"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12"
                                           Foreground="{StaticResource HostMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
