<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EverythingLabeled.ExplorerCommand</RootNamespace>
    <AssemblyName>EverythingLabeled.ExplorerCommand</AssemblyName>
    <EnableComHosting>true</EnableComHosting>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverythingLabeled.ExplorerShared\EverythingLabeled.ExplorerShared.csproj" />
    <ProjectReference Include="..\EverythingLabeled.ExplorerHost\EverythingLabeled.ExplorerHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Package\AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" Link="AppxManifest.xml" />
    <None Include="Package\Assets\**\*" CopyToOutputDirectory="PreserveNewest" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyExplorerHostOutput" AfterTargets="Build">
    <PropertyGroup>
      <_HostOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\EverythingLabeled.ExplorerHost\bin\$(Configuration)\net8.0-windows\'))</_HostOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_HostFiles Include="$(_HostOutDir)**\*" />
    </ItemGroup>
    <Error Condition="'@(_HostFiles)' == ''" Text="ExplorerHost output not found under $(_HostOutDir). Build Host first." />
    <Copy SourceFiles="@(_HostFiles)" DestinationFolder="$(TargetDir)%(_HostFiles.RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
