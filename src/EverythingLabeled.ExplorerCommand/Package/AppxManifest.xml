<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
    xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap10 com desktop4 desktop5 rescap">

  <Identity
      Name="EverythingLabeled.ExplorerDev"
      Publisher="CN=EverythingLabeled-Dev"
      Version="0.1.7.0"
      ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>EverythingLabeled</DisplayName>
    <PublisherDisplayName>EverythingLabeled</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-cn" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
        Id="Explorer"
        Executable="EverythingLabeled.ExplorerHost.exe"
        uap10:TrustLevel="mediumIL"
        uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
          AppListEntry="none"
          DisplayName="EverythingLabeled"
          Description="EverythingLabeled Explorer context menu"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <com:Extension Category="windows.comServer" uap10:RuntimeBehavior="packagedClassicApp">
          <com:ComServer>
            <com:SurrogateServer DisplayName="EverythingLabeled Explorer Commands">
              <com:Class
                  Id="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A01"
                  Path="EverythingLabeled.ExplorerCommand.comhost.dll"
                  ThreadingModel="STA" />
              <com:Class
                  Id="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A02"
                  Path="EverythingLabeled.ExplorerCommand.comhost.dll"
                  ThreadingModel="STA" />
              <com:Class
                  Id="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A03"
                  Path="EverythingLabeled.ExplorerCommand.comhost.dll"
                  ThreadingModel="STA" />
              <com:Class
                  Id="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A04"
                  Path="EverythingLabeled.ExplorerCommand.comhost.dll"
                  ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ElTag" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A01" />
              <desktop5:Verb Id="ElUntag" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A02" />
              <desktop5:Verb Id="ElTags" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A03" />
              <desktop5:Verb Id="ElFind" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A04" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ElTagDir" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A01" />
              <desktop5:Verb Id="ElUntagDir" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A02" />
              <desktop5:Verb Id="ElTagsDir" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A03" />
              <desktop5:Verb Id="ElFindDir" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A04" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="ElFindBackground" Clsid="6F3C8A21-9B4E-4D71-A2C8-1E5F0D8B7A04" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
