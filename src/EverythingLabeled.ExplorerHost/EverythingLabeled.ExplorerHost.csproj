<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EverythingLabeled.ExplorerHost</RootNamespace>
    <AssemblyName>EverythingLabeled.ExplorerHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverythingLabeled.Client\EverythingLabeled.Client.csproj" />
    <ProjectReference Include="..\EverythingLabeled.ExplorerShared\EverythingLabeled.ExplorerShared.csproj" />
  </ItemGroup>

</Project>
